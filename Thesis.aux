\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Global statistical performance of the holographic $\mathrm  {ER}=\mathrm  {EPR}$ tensor network against the SPARC database.} \textit  {Left:} Asymptotic plateau velocity $v_\infty $ predicted by holographic boundary min-cuts versus the maximum observed rotation velocity $v_{\max }$ across $N = 171$ galaxies, closely tracking the $1:1$ identity relation across more than a decade in velocity. \textit  {Center:} Distribution of kinematic velocity residuals ($\Delta v = v_{\mathrm  {obs}} - v_{\mathrm  {model}}$) evaluated across $N_{\mathrm  {points}} = 3375$ individual measurements, centered on zero bias ($\Delta v = 0\,\mathrm  {km/s}$). \textit  {Right:} Global distribution of the reduced goodness-of-fit statistic $\chi ^2_\nu $, yielding a sample median of $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \chi $}\mathaccent "0365{\chi }^2_\nu = 3.97$.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:sparc_global_diagnostics}{{1}{3}{\textbf {Global statistical performance of the holographic $\mathrm {ER}=\mathrm {EPR}$ tensor network against the SPARC database.} \textit {Left:} Asymptotic plateau velocity $v_\infty $ predicted by holographic boundary min-cuts versus the maximum observed rotation velocity $v_{\max }$ across $N = 171$ galaxies, closely tracking the $1:1$ identity relation across more than a decade in velocity. \textit {Center:} Distribution of kinematic velocity residuals ($\Delta v = v_{\mathrm {obs}} - v_{\mathrm {model}}$) evaluated across $N_{\mathrm {points}} = 3375$ individual measurements, centered on zero bias ($\Delta v = 0\,\mathrm {km/s}$). \textit {Right:} Global distribution of the reduced goodness-of-fit statistic $\chi ^2_\nu $, yielding a sample median of $\widetilde {\chi }^2_\nu = 3.97$}{figure.1}{}}
